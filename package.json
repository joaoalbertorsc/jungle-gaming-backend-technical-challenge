{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Distributed wallet and wagering transaction processor (Jungle Gaming backend challenge).",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:focused-tests": "bun run scripts/check-focused-tests.ts",
    "test": "bun test --timeout 30000",
    "test:unit": "bun test test/unit",
    "test:unit:coverage": "bun test test/unit --coverage",
    "test:integration": "bun test test/integration --timeout 30000",
    "test:e2e": "bun test test/e2e --timeout 30000",
    "test:infra": "bun test test/integration test/e2e --timeout 30000",
    "verify": "bun run check:focused-tests && bun run format:check && bun run lint && bun run typecheck && bun run test",
    "migration:up": "bun run scripts/migrate.ts up",
    "migration:down": "bun run scripts/migrate.ts down",
    "migration:pending": "bun run scripts/migrate.ts pending",
    "sqs:bootstrap": "bun run scripts/sqs-bootstrap.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1168.0",
    "@mikro-orm/core": "^7.2.9",
    "@mikro-orm/migrations": "^7.2.9",
    "@mikro-orm/postgresql": "^7.2.9",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.5.0",
    "@types/bun": "^1.4.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
